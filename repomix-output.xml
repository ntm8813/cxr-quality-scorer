# ── Show current image ─────────────────────────────────────────
current = unrated[0]
img_arr = cv2.imread(str(current), cv2.IMREAD_GRAYSCALE)

idx_now = len(rated_uids) + 1
st.markdown(
    f"**Image {idx_now} / {len(all_images)}:** `{current.name}`"
)

col_img, col_form = st.columns([1, 1])

with col_img:
    if img_arr is not None:
        st.image(
