    with pytest.raises(ValidationError):
        AxisResult(
            study_uid="1.2.3.4",
            axis=AxisName.SHARPNESS,
            score=1.5,  # Invalid: Must be <= 1.0
            flag=QualityFlag.ACCEPTABLE
        )

