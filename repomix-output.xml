import random
import h5py
import yaml
import pandas as pd
import numpy as np

from scipy.stats import spearmanr

from src.scorers.exposure_scorer import ExposureScorer
from src.scorers.sharpness_scorer import SharpnessScorer
from src.scorers.rotation_scorer import RotationScorer


H5_PATH = "data/processed/cxr_degraded.h5"
MANIFEST_PATH = "data/processed/degradation_manifest.csv"
CONFIG_PATH = "configs/v1.yaml"

SAMPLES_PER_SEVERITY = 500
RANDOM_SEED = 42


def sample_axis_rows(df_axis):
    sampled = []

    for severity in sorted(df_axis["severity"].unique()):
        group = df_axis[df_axis["severity"] == severity]

        n = min(SAMPLES_PER_SEVERITY, len(group))

        sampled.append(
            group.sample(
                n=n,
                random_state=RANDOM_SEED
            )
        )

    return pd.concat(sampled, ignore_index=True)


def evaluate_axis(axis_name, scorer, manifest, h5):

    rows = manifest[manifest["axis"] == axis_name]

    if len(rows) == 0:
        print(f"\n{axis_name}: no rows found")
        return

    rows = sample_axis_rows(rows)

    severities = []
    scores = []

    print("\n" + "=" * 70)
    print(f"Evaluating {axis_name.upper()}")
    print(f"Samples: {len(rows)}")
    print("=" * 70)

    for _, row in rows.iterrows():

        uid = row["uid"]

        if uid not in h5:
            continue

        image = h5[uid][:]

        result = scorer.score(
            image,
            {
                "study_uid": uid
            }
        )

        severities.append(
            int(row["severity"])
        )

        scores.append(
            float(result.score)
        )

    if len(scores) == 0:
        print("No valid samples")
        return

    rho, p = spearmanr(
        severities,
        scores
    )

    print(f"Spearman rho : {rho:.4f}")
    print(f"P-value      : {p:.4e}")
    print(f"N samples    : {len(scores)}")

    if abs(rho) >= 0.75:
        print("STATUS       : PASS")
    else:
        print("STATUS       : FAIL")


def main():

    random.seed(RANDOM_SEED)
    np.random.seed(RANDOM_SEED)

    with open(CONFIG_PATH, "r") as f:
        config = yaml.safe_load(f)

    scorers = {
        "exposure": ExposureScorer(config),
        "blur": SharpnessScorer(config),
        "rotation": RotationScorer(config)
    }

    manifest = pd.read_csv(MANIFEST_PATH)

    print("\nManifest summary")
    print(
        manifest.groupby(
            ["axis", "severity"]
        ).size()
    )

    with h5py.File(H5_PATH, "r") as h5:

        evaluate_axis(
            "exposure",
            scorers["exposure"],
            manifest,
            h5
        )

        evaluate_axis(
            "blur",
            scorers["blur"],
            manifest,
            h5
        )

        evaluate_axis(
            "rotation",
            scorers["rotation"],
            manifest,
            h5
        )

    print("\nFinished.")


if __name__ == "__main__":
    main()
