    result = blur_scorer.score(image, _meta())
    assert 0.0 <= result.score <= 1.0


def test_blur_scorer_uniform_bright_image(blur_scorer):
    """Fully saturated image — should not crash."""
    image  = np.ones((1024, 1024), dtype=np.float32)
    result = blur_scorer.score(image, _meta())
    assert 0.0 <= result.score <= 1.0


