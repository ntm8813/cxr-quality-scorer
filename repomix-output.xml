CONFIG_PATH = "configs/v1.yaml"


def circular_distance_deg(a: float, b: float, period: float = 180.0) -> float:
    """
    Smallest absolute angular difference on a circular domain.
    For orientation-style measurements, 180 degrees periodicity is appropriate.
    """
    diff = (a - b + period / 2.0) % period - period / 2.0
    return abs(float(diff))


def patient_pair_rho(badness_1: float, badness_2: float) -> float:
    """
    Spearman rho for a single patient pair:
    severity [1, 2] vs badness [b1, b2].

    With only two points, rho is effectively:
    - +1 when badness increases with severity
    - -1 when it decreases
    - 0 when tied / undefined
    """
    rho = spearmanr([1, 2], [badness_1, badness_2]).correlation
    if rho is None or np.isnan(rho):
        return 0.0
    return float(rho)


def evaluate_axis(axis_name, scorer, manifest, h5):
    rows = manifest[manifest["axis"] == axis_name]
    if len(rows) == 0:
        print(f"\n{axis_name}: no rows found")
        return

    patient_rhos = []
    correct_pairs = 0
    total_pairs = 0

    print("\n" + "=" * 70)
    print(f"Evaluating {axis_name.upper()}")
    print("=" * 70)

    for base_uid, group in rows.groupby("base_uid"):
        sev1 = group[group["severity"] == 1]
        sev2 = group[group["severity"] == 2]

        if len(sev1) == 0 or len(sev2) == 0:
            continue

        uid1 = sev1.iloc[0]["uid"]
        uid2 = sev2.iloc[0]["uid"]
        uid0 = f"{base_uid}_clean_0"

        if uid0 not in h5 or uid1 not in h5 or uid2 not in h5:
            continue

        try:
            if axis_name == "rotation":
                clean_angle = scorer.score(
                    h5[uid0][:],
                    {"study_uid": uid0}
                ).raw_metrics["rotation_angle_deg_signed"]

                angle1 = scorer.score(
                    h5[uid1][:],
                    {"study_uid": uid1}
                ).raw_metrics["rotation_angle_deg_signed"]

                angle2 = scorer.score(
                    h5[uid2][:],
                    {"study_uid": uid2}
                ).raw_metrics["rotation_angle_deg_signed"]

                badness1 = circular_distance_deg(angle1, clean_angle, period=180.0)
                badness2 = circular_distance_deg(angle2, clean_angle, period=180.0)

            elif axis_name == "blur":
                score1 = scorer.score(
                    h5[uid1][:],
                    {"study_uid": uid1}
                ).score

                score2 = scorer.score(
                    h5[uid2][:],
                    {"study_uid": uid2}
                ).score

                # Higher badness = worse quality
                badness1 = 1.0 - float(score1)
                badness2 = 1.0 - float(score2)

            else:  # exposure
                score1 = scorer.score(
                    h5[uid1][:],
                    {"study_uid": uid1}
                ).score

                score2 = scorer.score(
                    h5[uid2][:],
                    {"study_uid": uid2}
                ).score

                # Higher badness = worse quality
                badness1 = 1.0 - float(score1)
                badness2 = 1.0 - float(score2)

            rho = patient_pair_rho(badness1, badness2)
            patient_rhos.append(rho)

            total_pairs += 1
            if badness2 > badness1:
                correct_pairs += 1

        except Exception:
            continue

    if total_pairs == 0:
        print("No valid pairs")
        return

    mean_rho = float(np.mean(patient_rhos))
    median_rho = float(np.median(patient_rhos))
    pairwise_accuracy = correct_pairs / total_pairs

    print(f"Patient-level mean rho : {mean_rho:.4f}")
    print(f"Patient-level median rho: {median_rho:.4f}")
    print(f"Pairwise accuracy      : {pairwise_accuracy:.4f}")
    print(f"N pairs                : {total_pairs}")

    if mean_rho >= 0.75:
        print("STATUS                 : PASS")
    else:
        print("STATUS                 : FAIL")


def main():
    with open(CONFIG_PATH, "r") as f:
        config = yaml.safe_load(f)

    scorers = {
        "exposure": ExposureScorer(config),
        "blur": SharpnessScorer(config),
        "rotation": RotationScorer(config),
    }

    manifest = pd.read_csv(MANIFEST_PATH)

    print("\nManifest summary")
    print(manifest.groupby(["axis", "severity"]).size())

    with h5py.File(H5_PATH, "r") as h5:
        evaluate_axis("exposure", scorers["exposure"], manifest, h5)
        evaluate_axis("blur", scorers["blur"], manifest, h5)
        evaluate_axis("rotation", scorers["rotation"], manifest, h5)

    print("\nFinished.")


if __name__ == "__main__":
    main()
